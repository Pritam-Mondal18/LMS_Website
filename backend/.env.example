# =====================================================
# Sumit Chakraborty Academy - Backend Environment Config
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=30d

# Email (Gmail SMTP)
USER_EMAIL=your_email@gmail.com
USER_PASSWORD=your_gmail_app_password

# Frontend URL (for CORS & email links)
CLIENT_URL=http://localhost:5173

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
